POSTGRES_USER=sonora
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=sonoraplay
PG_PORT=5432
DATABASE_URL=postgresql+psycopg://sonora:cambia_esto@localhost:5432/sonoraplay
TEST_DATABASE_URL=postgresql+psycopg://sonora:cambia_esto@localhost:5432/sonoraplay_test
SEED=42
TASA_DEFECTOS=0.02
API_CONTRATOS_PORT=8000
API_TITULARES_PORT=8001
# Clave de firma de los tokens de sellos (ADR-0006). Este valor es FALSO y la app lo rechaza.
# Genera la tuya: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TITULARES_JWT_SECRET=cambia_esto
# Seed en Docker Compose (EG-25). Por defecto, la muestra versionada con 50 titulares.
# Para el CSV completo de Kaggle en data/raw/dataset.csv (ver README):
# F1_ENTRADA=/datos/entrada/raw/dataset.csv
# F1_TITULARES=1500
# F3_MODO=dev
