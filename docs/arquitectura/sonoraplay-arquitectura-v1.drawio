ed=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="730"/><mxPoint x="240" y="1050"/><mxPoint x="1660" y="1050"/><mxPoint x="1660" y="151"/></Array></mxGeometry></mxCell><mxCell id="c53" value="⑫ túnel SSM (sin IP pública)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#C925D1;fontSize=10;fontColor=#C925D1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="530"/><mxPoint x="230" y="902"/></Array></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="&lt;b&gt;Leyenda.&lt;/b&gt; 24/7 = servicio siempre encendido · Fargate Spot = hasta ~70% más barato, puede ser interrumpido (el ACK manual y los reintentos de Airflow evitan perder datos) · bajo demanda = solo se paga mientras corre · gris punteado = se enciende solo en Sprint 5 y demo.&lt;br&gt;&lt;b&gt;Flujos:&lt;/b&gt; ①–③ consulta de sellos (RN-11) · ④–⑥ ingesta sin pérdidas (RF-01, RNF-04) · ⑦–⑨ procesamiento y liquidación del día 3 (RN-01…RN-10, RNF-01) · ⑩ fuentes externas por la NAT · ⑪ CI/CD · ⑫ analítica en Power BI.&lt;br&gt;&lt;b&gt;Descartados de la plantilla de referencia:&lt;/b&gt; DynamoDB (API sin estado), Memcache (sin requisito de caché), Amazon SES (no se envían correos a sellos; las alertas van por SNS), Auto Scaling de EC2 (ECS Fargate cubre los servicios). Todo se crea y destruye con Terraform." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D5DBDB;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="1650" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>