#!/bin/bash
# Instancia NAT sobre Amazon Linux 2023 (ADR-0010): reenvía y enmascara el tráfico de la VPC.
set -euo pipefail

dnf install -y iptables-services
systemctl enable --now iptables

cat > /etc/sysctl.d/90-nat.conf <<'EOF'
net.ipv4.ip_forward = 1
EOF
sysctl --system

interfaz=$(ip route show default | awk '{print $5; exit}')

# La configuración por defecto de iptables-services rechaza todo en FORWARD.
iptables -F FORWARD
iptables -t nat -A POSTROUTING -o "$interfaz" -s ${vpc_cidr} -j MASQUERADE
service iptables save
